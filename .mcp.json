{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "ag-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "ag-mcp"
      ],
      "env": {}
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": [
        "graphify-out/graph.json"
      ],
      "env": {}
    }
  }
}
