{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./vendor/**)",
      "Read(./node_modules/**)",
      "Read(./public/build/**)",
      "Read(./public/hot/**)",
      "Read(./storage/app/public/**)",
      "Read(./storage/framework/cache/**)",
      "Read(./storage/framework/sessions/**)",
      "Read(./storage/framework/views/**)",
      "Read(./storage/logs/**)",
      "Read(./storage/pail/**)",
      "Read(./bootstrap/cache/**)",
      "Read(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./.fleet/**)",
      "Read(./.nova/**)",
      "Read(./.zed/**)",
      "Read(./package-lock.json)",
      "Read(./composer.lock)",
      "Read(./**/*.log)",
      "Read(./auth.json)",
      "Read(./.env)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "./storage/**/.gitignore",
        "./bootstrap/cache/.gitignore",
        "./package-lock.json",
        "./composer.lock",
        "./vendor/**",
        "./node_modules/**"
      ],
      "allowWrite": [
        "~/.cache/graphify-rebuild.log",
        "~/.cache/graphify-queries.log",
        "~/.graphify/**"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || true"
          }
        ]
      }
    ]
  }
}
